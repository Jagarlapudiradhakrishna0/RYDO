# =====================================================
# RYDO BACKEND CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your actual .env file to GitHub.
# =====================================================

# MongoDB connection URI (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING

# Port for the Express and Socket.IO server (Default: 5000)
PORT=5000
