# =====================================================
# RYDO MOBILE CONFIGURATION TEMPLATE
# Copy this file to .env and adjust if using a local backend.
# NEVER commit your actual .env file to GitHub.
# =====================================================

# --- OPTION 1: Public Production Backend (Default) ---
# Use this when testing on physical phones or sharing across different networks.
EXPO_PUBLIC_API_URL=https://rydo-irav.onrender.com
EXPO_PUBLIC_SOCKET_URL=https://rydo-irav.onrender.com

# --- OPTION 2: Local Backend (Uncomment when running backend locally) ---
# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# For Physical Android Phone (Must be on the same Wi-Fi network as PC):
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5000
# EXPO_PUBLIC_SOCKET_URL=http://YOUR_COMPUTER_LAN_IP:5000
